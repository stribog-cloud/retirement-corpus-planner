# Component: TrustNotice
# Renderer: src/main.jsx:1328 (React.memo)
# Role: Trust guardrail notice with title, body, tone, icon, and optional action buttons.
# Interactivity: action buttons inside are pressable; notice itself is informational.
# State applicability:
#   default   YES  notice visible; tone colors applied (teal/gold/red)
#   hover     NO   notice itself not hoverable
#   focus     YES  action buttons inside can receive keyboard focus
#   active    YES  action button pressed (onClick called)
#   disabled  YES  action button disabled={true} (prop on each action)
#   loading   NO   no loading state
#   error     NO   notice itself does not have an error state
#   empty     NO   always rendered when present in tree (parent controls visibility)
#   stale     NO   informational only
#   dirty     NO   no input
#   drag-*    NO   not draggable
# Note: tone = teal (info/trust), gold (caution), red (warning/danger)

direction: right

default_teal: {
  shape: rectangle
  label: "default (teal)\ntrust-notice trust-teal"
  style: {
    fill: "#e0f2f1"
    stroke: "#00897b"
    border-radius: 8
  }
}

default_gold: {
  shape: rectangle
  label: "default (gold)\ntrust-notice trust-gold"
  style: {
    fill: "#fff8e1"
    stroke: "#f0a500"
    border-radius: 8
  }
}

action_focus: {
  shape: rectangle
  label: "action focused\n(action button tab-focused)"
  style: {
    fill: "#e3f2fd"
    stroke: "#1565c0"
    border-radius: 8
  }
}

action_active: {
  shape: rectangle
  label: "action active\n(action button clicked; onClick fired)"
  style: {
    fill: "#bbdefb"
    stroke: "#0d47a1"
    border-radius: 8
  }
}

action_disabled: {
  shape: rectangle
  label: "action disabled\n(action.disabled=true)"
  style: {
    fill: "#eeeeee"
    stroke: "#9e9e9e"
    border-radius: 8
  }
}

default_teal -> action_focus: "tab to action button"
default_gold -> action_focus: "tab to action button"
action_focus -> action_active: "enter / click"
action_active -> default_teal: "action complete"
action_active -> default_gold: "action complete"
default_teal -> action_disabled: "action.disabled = true"
default_gold -> action_disabled: "action.disabled = true"
action_disabled -> default_teal: "action.disabled = false"
action_disabled -> default_gold: "action.disabled = false"
