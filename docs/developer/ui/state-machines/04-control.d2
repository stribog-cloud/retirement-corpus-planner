# Component: Control
# Renderer: src/main.jsx:1029
# Role: Form field wrapper combining label, help-chip, select or NumberEntry, and range input.
# Interactivity: wraps NumberEntry or <select>; label click focuses inner input.
# State applicability:
#   default   YES  label + value shown, no modifier
#   hover     YES  CSS :hover on label element
#   focus     YES  inner input focused (via NumberEntry or select)
#   active    NO   not directly pressable
#   disabled  YES  disabled={true} adds is-disabled class; inner inputs disabled
#   loading   NO   no loading state
#   error     NO   no built-in error rendering (parent handles)
#   empty     NO   always renders (value from parent)
#   stale     NO   display reflects parent state
#   dirty     YES  inner NumberEntry in dirty state (draft != committed)
#   drag-*    NO   not draggable

direction: right

default: {
  shape: rectangle
  label: "default\n(label + value, enabled)"
  style: {
    fill: "#e8f4fd"
    stroke: "#4a90d9"
    border-radius: 6
  }
}

hover: {
  shape: rectangle
  label: "hover\n(label container highlighted)"
  style: {
    fill: "#d4ebfa"
    stroke: "#2c6fad"
    border-radius: 6
  }
}

focus: {
  shape: rectangle
  label: "focus\n(inner input focused)"
  style: {
    fill: "#e3f2fd"
    stroke: "#1565c0"
    border-radius: 6
  }
}

dirty: {
  shape: rectangle
  label: "dirty\n(inner NumberEntry draft != value)"
  style: {
    fill: "#fff9c4"
    stroke: "#f9a825"
    border-radius: 6
  }
}

disabled: {
  shape: rectangle
  label: "disabled\n(is-disabled class; inputs disabled)"
  style: {
    fill: "#eeeeee"
    stroke: "#9e9e9e"
    border-radius: 6
  }
}

default -> hover: "pointer-enter label"
hover -> default: "pointer-leave"
hover -> focus: "click / tab into inner input"
default -> focus: "tab"
focus -> dirty: "keydown in NumberEntry"
dirty -> default: "blur / commit"
default -> disabled: "disabled = true"
disabled -> default: "disabled = false"
