# Component: StatCard
# Renderer: src/main.jsx:939 (React.memo)
# Role: KPI display card with accent, icon, sparkline, and status badge.
# Interactivity: hover (lift/shadow via CSS), focus via keyboard if wrapped in a link/button.
# State applicability:
#   default   YES  normal render with value, sub, accent, optional icon and spark
#   hover     YES  CSS :hover lifts card shadow (no JS state)
#   focus     NO   StatCard itself is not focusable (article element, no tabIndex)
#   active    NO   not pressable
#   disabled  NO   no disabled prop
#   loading   YES  status prop with tone="pending" shows badge overlay
#   error     YES  status prop with tone="danger" shows error badge
#   empty     YES  value/sub may render as dash/empty string when data absent
#   stale     YES  status prop with tone="warning" / pending badge
#   dirty     NO   display-only component, no input
#   drag-*    NO   not draggable

direction: right

default: {
  shape: rectangle
  label: "default\n(value + sub + spark)"
  style: {
    fill: "#e8f4fd"
    stroke: "#4a90d9"
    border-radius: 8
  }
}

hover: {
  shape: rectangle
  label: "hover\n(shadow lifted)"
  style: {
    fill: "#d4ebfa"
    stroke: "#2c6fad"
    border-radius: 8
  }
}

loading: {
  shape: rectangle
  label: "loading\n(status badge: pending)"
  style: {
    fill: "#fff8e1"
    stroke: "#f0a500"
    border-radius: 8
  }
}

error: {
  shape: rectangle
  label: "error\n(status badge: danger)"
  style: {
    fill: "#fdecea"
    stroke: "#e53935"
    border-radius: 8
  }
}

stale: {
  shape: rectangle
  label: "stale\n(status badge: warning)"
  style: {
    fill: "#fff3e0"
    stroke: "#fb8c00"
    border-radius: 8
  }
}

empty: {
  shape: rectangle
  label: "empty\n(value = dash/zero)"
  style: {
    fill: "#f5f5f5"
    stroke: "#9e9e9e"
    border-radius: 8
  }
}

default -> hover: "pointer-enter"
hover -> default: "pointer-leave"
default -> loading: "status.tone = pending"
loading -> default: "status cleared"
default -> error: "status.tone = danger"
error -> default: "status cleared"
default -> stale: "status.tone = warning"
stale -> default: "status cleared"
default -> empty: "value / sub absent"
empty -> default: "data arrives"
