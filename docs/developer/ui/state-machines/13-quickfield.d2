# Component: QuickField
# Renderer: src/main.jsx:1220
# Role: Compact labeled number field (wraps NumberEntry) used in guided intake grids.
# Interactivity: same as NumberEntry; label wrapper adds is-disabled class.
# State applicability:
#   default   YES  label + NumberEntry shown; not focused
#   hover     YES  CSS :hover on quick-field label
#   focus     YES  inner NumberEntry focused
#   active    YES  digit entry / arrow key
#   disabled  YES  disabled={true} adds is-disabled class
#   loading   NO   no loading state
#   error     NO   no error rendering
#   empty     YES  value = 0 (NumberEntry shows 0 or hint)
#   stale     NO   reflects parent
#   dirty     YES  inner NumberEntry draft != committed value
#   drag-*    NO   not draggable

direction: right

default: {
  shape: rectangle
  label: "default\n(label + value, enabled)"
  style: {
    fill: "#e8f4fd"
    stroke: "#4a90d9"
    border-radius: 6
  }
}

hover: {
  shape: rectangle
  label: "hover\n(label highlighted)"
  style: {
    fill: "#d4ebfa"
    stroke: "#2c6fad"
    border-radius: 6
  }
}

focus: {
  shape: rectangle
  label: "focus\n(inner NumberEntry focused)"
  style: {
    fill: "#e3f2fd"
    stroke: "#1565c0"
    border-radius: 6
  }
}

dirty: {
  shape: rectangle
  label: "dirty\n(draft != committed)"
  style: {
    fill: "#fff9c4"
    stroke: "#f9a825"
    border-radius: 6
  }
}

disabled: {
  shape: rectangle
  label: "disabled\n(is-disabled class)"
  style: {
    fill: "#eeeeee"
    stroke: "#9e9e9e"
    border-radius: 6
  }
}

empty: {
  shape: rectangle
  label: "empty\n(value = 0)"
  style: {
    fill: "#f5f5f5"
    stroke: "#bdbdbd"
    border-radius: 6
  }
}

default -> hover: "pointer-enter"
hover -> default: "pointer-leave"
hover -> focus: "click / tab"
default -> focus: "tab"
focus -> dirty: "keydown"
dirty -> default: "blur / commit"
default -> disabled: "disabled = true"
disabled -> default: "disabled = false"
default -> empty: "value = 0"
empty -> dirty: "keydown in focus"
