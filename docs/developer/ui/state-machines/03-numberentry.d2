# Component: NumberEntry
# Renderer: src/main.jsx:970
# Role: Numeric text input with debounced commit, INR formatting hint, min/max/step.
# Interactivity: full keyboard/pointer interactive input.
# State applicability:
#   default   YES  displays external value; not focused
#   hover     YES  CSS :hover border highlight
#   focus     YES  setFocused(true), draft decoupled from prop
#   active    YES  pressing/holding stepper or keyboard digit entry
#   disabled  YES  disabled={true} prop; input attr disabled
#   loading   NO   no loading state (sync component)
#   error     NO   no error rendering in component itself (parent wraps if needed)
#   empty     YES  value=0 / empty draft; hint absent
#   stale     NO   draft syncs to prop on blur
#   dirty     YES  draft !== prop value (focused and not yet committed)
#   drag-*    NO   not draggable

direction: right

default: {
  shape: rectangle
  label: "default\n(shows prop value, not focused)"
  style: {
    fill: "#e8f4fd"
    stroke: "#4a90d9"
    border-radius: 6
  }
}

hover: {
  shape: rectangle
  label: "hover\n(border accent)"
  style: {
    fill: "#d4ebfa"
    stroke: "#2c6fad"
    border-radius: 6
  }
}

focus: {
  shape: rectangle
  label: "focus\n(draft decoupled; focused=true)"
  style: {
    fill: "#e3f2fd"
    stroke: "#1565c0"
    border-radius: 6
  }
}

dirty: {
  shape: rectangle
  label: "dirty\n(draft !== committed value)"
  style: {
    fill: "#fff9c4"
    stroke: "#f9a825"
    border-radius: 6
  }
}

active: {
  shape: rectangle
  label: "active\n(key held / digit entering)"
  style: {
    fill: "#e1f5fe"
    stroke: "#0288d1"
    border-radius: 6
  }
}

disabled: {
  shape: rectangle
  label: "disabled\n(disabled={true})"
  style: {
    fill: "#eeeeee"
    stroke: "#9e9e9e"
    border-radius: 6
  }
}

empty: {
  shape: rectangle
  label: "empty\n(draft='', value=0)"
  style: {
    fill: "#f5f5f5"
    stroke: "#bdbdbd"
    border-radius: 6
  }
}

default -> hover: "pointer-enter"
hover -> default: "pointer-leave"
hover -> focus: "click / tab"
default -> focus: "tab"
focus -> dirty: "keydown (char entered)"
dirty -> focus: "backspace clears to prop"
dirty -> default: "blur (commit called)"
focus -> default: "blur (no change)"
default -> active: "arrow-up / arrow-down"
active -> dirty: "value changed"
active -> default: "key-up"
default -> disabled: "disabled prop = true"
disabled -> default: "disabled prop = false"
default -> empty: "value = 0 / empty string"
empty -> dirty: "keydown (char entered)"
