# Component: LegendRows
# Renderer: src/main.jsx:6381 (React.memo)
# Role: Chart legend with dot-colored rows mapping label to value.
# Interactivity: display only, no pointer/keyboard interaction.
# State applicability:
#   default   YES  rows rendered with dot color, label, value
#   hover     NO   display only
#   focus     NO   not focusable
#   active    NO   not pressable
#   disabled  NO   no disabled prop
#   loading   NO   no loading state
#   error     NO   no error state
#   empty     YES  rows = [] renders empty container
#   stale     NO   display only, reflects parent
#   dirty     NO   display only
#   drag-*    NO   not draggable

direction: right

default: {
  shape: rectangle
  label: "default\n(rows rendered with color dots)"
  style: {
    fill: "#e8f4fd"
    stroke: "#4a90d9"
    border-radius: 6
  }
}

empty: {
  shape: rectangle
  label: "empty\n(rows = [])"
  style: {
    fill: "#f5f5f5"
    stroke: "#bdbdbd"
    border-radius: 6
  }
}

default -> empty: "rows array cleared"
empty -> default: "rows populated"
